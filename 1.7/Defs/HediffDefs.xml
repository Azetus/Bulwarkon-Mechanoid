<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef>
        <defName>BM_HealingSmokeHediff</defName>
        <label>healing smoke</label>
        <description>Healing smoke tends wounds and slowly mends injuries.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <initialSeverity>1.0</initialSeverity>
        <defaultLabelColor>(0.5, 0.9, 0.5)</defaultLabelColor>
        <stages>
            <li>
                <statFactors>
                    <Flammability>0</Flammability>
                </statFactors>
            </li>
        </stages>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>70</disappearsAfterTicks>
            </li>
            <li Class="HediffCompProperties_Link">
                <requireLinkOnOtherPawn>false</requireLinkOnOtherPawn>
            </li>
            <li Class="BM_BulwarkonMechanoid.Hediffs.HediffCompProperties_HealingSmoke">
                <tendQuality>1.0</tendQuality>
                <tendMaxQuality>1.3</tendMaxQuality>
            </li>
            <li Class="HediffCompProperties_Effecter">
                <stateEffecter>BM_HealingSmoke_BodyEffect</stateEffecter>
            </li>
        </comps>
    </HediffDef>
</Defs>
